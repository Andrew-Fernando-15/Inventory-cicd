# Django Environment Configuration (Production)
DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=inventory_prod_db
DB_USER=prod_inventory_admin
DB_PASSWORD=replace-with-strong-prod-database-password
DB_HOST=db
DB_PORT=5432

# PostgreSQL Container Initialization
POSTGRES_DB=inventory_prod_db
POSTGRES_USER=prod_inventory_admin
POSTGRES_PASSWORD=replace-with-strong-prod-database-password
